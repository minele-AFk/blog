# JWT 密钥（用于生成管理员认证令牌）
# 生产环境必须设置此值！长度需 ≥ 32 字符，且不能使用示例占位符
# 生成方式：openssl rand -hex 32（或等效的强随机值）
JWT_SECRET=your-jwt-secret-here

# 管理员密码（登录时使用）
# 首次启动时自动用此密码初始化管理员账户（用于防抢注；未配置时无法通过网页初始化）
# 建议强度：长度 ≥ 12 字符，混合大小写字母、数字与符号，且不要与其他账户共用
# bcrypt 限制：UTF-8 编码总长度不能超过 72 字节
ADMIN_PASSWORD=your-admin-password

# Bangumi API Token（用于同步追番数据）
# 获取方式：https://next.bgm.tv/demo/access-token
# 仅向官方 api.bgm.tv 发送；若旧版本曾使用镜像接口，请撤销旧 token 并换新
BANGUMI_TOKEN=your-bangumi-token-here

# Cron Secret（用于定时同步认证，可选）
# 用于验证 Vercel Cron 或外部 cron 服务的请求
# 至少 32 字符强随机值；仅 POST + Authorization: Bearer，禁止把密钥放入 URL
CRON_SECRET=your-cron-secret-here

# Admin Token（可选，仅 cron 端点接受，不用于后台 JWT 登录）
# 与 CRON_SECRET 一样，至少 32 字符且不能使用示例值
ADMIN_TOKEN=your-admin-token-here

# Node.js 自建服务可选：只有反向代理保证覆盖该头，且应用端口不可被外部直连时才设置。
# 留空时登录使用共同限流桶，避免相信访客伪造的 X-Forwarded-For。
# Cloudflare Workers 自动使用边缘提供的 CF-Connecting-IP，无需配置此项。
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
